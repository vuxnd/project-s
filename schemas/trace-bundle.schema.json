{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trace bundle",
  "description": "build/<root>/traces/<host>/<implementation>/<contract>.<name>.json: one trace compiled for one implementation and host. Versioned with the embedded bundle's format (contract C6 in ARCHITECTURE.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["trace", "contract", "implementation", "ticks", "bundle", "inputs", "expect"],
  "properties": {
    "trace": { "type": "string", "minLength": 1 },
    "contract": { "$ref": "module.schema.json#/$defs/name" },
    "implementation": { "$ref": "module.schema.json#/$defs/name" },
    "ticks": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "bundle": { "$ref": "bundle.schema.json" },
    "inputs": { "type": "array", "items": { "$ref": "trace.schema.json#/$defs/input" } },
    "expect": { "type": "array", "minItems": 1, "items": { "$ref": "trace.schema.json#/$defs/expectation" } }
  }
}
