{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game composition",
  "description": "<root>/games/<id>/game.json, manifest format 1 (contract C2 in ARCHITECTURE.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "summary", "hosts", "fixedHz", "modules"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "manifest": { "description": "Manifest format. Absent means 1.", "const": 1 },
    "id": { "$ref": "module.schema.json#/$defs/name" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "module.schema.json#/$defs/name" } },
    "fixedHz": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "modules": {
      "type": "object",
      "propertyNames": { "$ref": "module.schema.json#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": { "$ref": "module.schema.json#/$defs/object" },
        "hosts": {
          "description": "Select this module only when building for one of these hosts.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "module.schema.json#/$defs/name" }
        }
      }
    }
  }
}
