{
  "$schema": "../../../../../schemas/trace.schema.json",
  "summary": "ctx.tick counts completed ticks and ctx.dt is 1/fixedHz in init and in systems; the module's state keeps its log between calls.",
  "fixedHz": 50,
  "ticks": 3,
  "records": {
    "probe.step": {
      "t01": { "$version": 1, "tick": 0, "in": "init", "do": "time" },
      "t02": { "$version": 1, "tick": 0, "in": "first", "do": "time" },
      "t03": { "$version": 1, "tick": 2, "in": "second", "do": "time" }
    }
  },
  "expect": [
    {
      "at": 0,
      "call": "probe.log",
      "equals": [
        { "tick": 0, "in": "init", "do": "time", "result": { "tick": 0, "dt": 0.02 } }
      ]
    },
    { "at": 3, "call": "probe.log", "pointer": "/2/result/tick", "equals": 2 },
    {
      "at": 3,
      "call": "probe.log",
      "equals": [
        { "tick": 0, "in": "init", "do": "time", "result": { "tick": 0, "dt": 0.02 } },
        { "tick": 0, "in": "first", "do": "time", "result": { "tick": 0, "dt": 0.02 } },
        { "tick": 2, "in": "second", "do": "time", "result": { "tick": 2, "dt": 0.02 } }
      ]
    }
  ]
}
