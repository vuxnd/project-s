{
  "$schema": "../../../../../schemas/trace.schema.json",
  "summary": "A module outside sees and absent is refused with not visible; a visible owner's undeclared id is unknown; has is true for what is seen.",
  "fixedHz": 50,
  "ticks": 1,
  "modules": ["probe_other"],
  "records": {
    "probe.step": {
      "v01": { "$version": 1, "tick": 0, "in": "first", "do": "records", "id": "probe_other.secret" },
      "v02": { "$version": 1, "tick": 0, "in": "first", "do": "events", "id": "probe_other.whisper" },
      "v03": { "$version": 1, "tick": 0, "in": "first", "do": "emit", "id": "probe_other.whisper", "payload": {} },
      "v04": { "$version": 1, "tick": 0, "in": "first", "do": "configOf", "id": "probe_other" },
      "v05": { "$version": 1, "tick": 0, "in": "first", "do": "has", "id": "probe_other" },
      "v06": { "$version": 1, "tick": 0, "in": "first", "do": "call", "id": "nowhere.op", "payload": {} },
      "v07": { "$version": 1, "tick": 0, "in": "first", "do": "events", "id": "probe.nothing" },
      "v08": { "$version": 1, "tick": 0, "in": "first", "do": "call", "id": "probe.nothing" },
      "v09": { "$version": 1, "tick": 0, "in": "first", "do": "has", "id": "probe" },
      "v10": { "$version": 1, "tick": 0, "in": "first", "do": "has", "id": "probe_impl" }
    }
  },
  "expect": [
    {
      "at": 1,
      "call": "probe.log",
      "equals": [
        { "tick": 0, "in": "first", "do": "records", "id": "probe_other.secret", "error": "not visible: probe_other.secret from probe_impl" },
        { "tick": 0, "in": "first", "do": "events", "id": "probe_other.whisper", "error": "not visible: probe_other.whisper from probe_impl" },
        { "tick": 0, "in": "first", "do": "emit", "id": "probe_other.whisper", "error": "not visible: probe_other.whisper from probe_impl" },
        { "tick": 0, "in": "first", "do": "configOf", "id": "probe_other", "error": "not visible: probe_other from probe_impl" },
        { "tick": 0, "in": "first", "do": "has", "id": "probe_other", "error": "not visible: probe_other from probe_impl" },
        { "tick": 0, "in": "first", "do": "call", "id": "nowhere.op", "error": "not visible: nowhere.op from probe_impl" },
        { "tick": 0, "in": "first", "do": "events", "id": "probe.nothing", "error": "unknown: probe.nothing" },
        { "tick": 0, "in": "first", "do": "call", "id": "probe.nothing", "error": "unknown: probe.nothing" },
        { "tick": 0, "in": "first", "do": "has", "id": "probe", "result": true },
        { "tick": 0, "in": "first", "do": "has", "id": "probe_impl", "result": true }
      ]
    }
  ]
}
