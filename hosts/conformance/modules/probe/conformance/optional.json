{
  "$schema": "../../../../../schemas/trace.schema.json",
  "summary": "With the optional probe_peer absent: has is false, events is empty, emit is ignored, call and configOf throw absent, records is empty.",
  "fixedHz": 50,
  "ticks": 1,
  "records": {
    "probe.step": {
      "p01": { "$version": 1, "tick": 0, "in": "init", "do": "has", "id": "probe_peer" },
      "p02": { "$version": 1, "tick": 0, "in": "first", "do": "has", "id": "probe_peer" },
      "p03": { "$version": 1, "tick": 0, "in": "first", "do": "events", "id": "probe_peer.note" },
      "p04": { "$version": 1, "tick": 0, "in": "first", "do": "call", "id": "probe_peer.add", "payload": { "n": 1 } },
      "p05": { "$version": 1, "tick": 0, "in": "first", "do": "configOf", "id": "probe_peer" },
      "p06": { "$version": 1, "tick": 0, "in": "first", "do": "emit", "id": "probe_peer.note", "payload": { "tick": 0 } },
      "p07": { "$version": 1, "tick": 0, "in": "first", "do": "records", "id": "probe_peer.nothing" }
    }
  },
  "expect": [
    {
      "at": 1,
      "call": "probe.log",
      "equals": [
        { "tick": 0, "in": "init", "do": "has", "id": "probe_peer", "result": false },
        { "tick": 0, "in": "first", "do": "has", "id": "probe_peer", "result": false },
        { "tick": 0, "in": "first", "do": "events", "id": "probe_peer.note", "result": [] },
        { "tick": 0, "in": "first", "do": "call", "id": "probe_peer.add", "error": "absent: probe_peer.add" },
        { "tick": 0, "in": "first", "do": "configOf", "id": "probe_peer", "error": "absent: probe_peer" },
        { "tick": 0, "in": "first", "do": "emit", "id": "probe_peer.note", "result": null },
        { "tick": 0, "in": "first", "do": "records", "id": "probe_peer.nothing", "result": {} }
      ]
    },
    { "by": 1, "emitted": "probe_peer.note", "count": 0 }
  ]
}
