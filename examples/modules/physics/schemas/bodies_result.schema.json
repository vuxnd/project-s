{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "position", "size"],
    "properties": {
      "id": { "type": "string" },
      "position": { "$ref": "vec3.schema.json", "x-unit": "m" },
      "size": { "$ref": "vec3.schema.json", "x-unit": "m" }
    }
  }
}
