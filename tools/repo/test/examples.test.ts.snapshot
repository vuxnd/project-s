    "fixed": ["physics_basic.integrate", "physics_basic.collide", "sandbox_rules.start"],
    "frame": []
  },
  "schemas": {
    "state": {
      "physics_basic": "tools/repo/test/fixtures/roots/sandbox/modules/physics_basic/schemas/state.schema.json"
    },
