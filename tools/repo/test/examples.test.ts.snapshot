  ],
  "contracts": {
    "physics": "physics_basic"
  },
  "operations": {
    "physics.bodies": "physics_basic",
    "physics.position": "physics_basic"
  },
  "events": {
    "physics.contact": "physics",
    "physics.spawn": "physics"
  },
  "types": {
    "physics.body": 1,
    "sandbox_rules.spawn": 1
  },
  "config": {
    "physics": {
      "gravity": [0, -20, 0]
    },
    "physics_basic": {
      "substeps": 1
    },
    "sandbox_rules": {}
  },
  "records": {
    "physics.body": {
      "sandbox_rules/crate": {
        "size": [1, 1, 1],
        "mass": 1
      },
      "sandbox_rules/plank": {
        "size": [4, 0.5, 2],
        "mass": 4
      }
    },
    "sandbox_rules.spawn": {
      "sandbox_rules/crate_a": {
        "body": "sandbox_rules/crate",
        "position": [0, 6, 0]
      },
      "sandbox_rules/crate_b": {
        "body": "sandbox_rules/crate",
        "position": [0.25, 9, 0]
      },
      "sandbox_rules/plank": {
        "body": "sandbox_rules/plank",
        "position": [0, 3.25, 0]
      }
    }
  },
  "assets": [],
