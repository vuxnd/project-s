exports[`bundle tools/repo/test/fixtures/roots/sandbox sandbox web 1`] = `
{
  "format": 1,
  "game": "sandbox",
  "host": "web",
  "fixedHz": 60,
  "modules": [
    {
      "id": "physics_basic",
      "entry": "tools/repo/test/fixtures/roots/sandbox/modules/physics_basic/ts/index.ts",
      "sees": ["physics", "physics_basic"],
      "absent": [],
      "packages": []
    },
    {
      "id": "audio",
      "entry": "tools/repo/test/fixtures/roots/sandbox/modules/audio/web/index.ts",
      "sees": ["audio", "physics"],
      "absent": [],
      "packages": []
    },
    {
      "id": "render_boxes",
      "entry": "tools/repo/test/fixtures/roots/sandbox/modules/render_boxes/web/index.ts",
      "sees": ["physics", "render_boxes"],
      "absent": [],
      "packages": []
    },
    {
      "id": "sandbox_rules",
      "entry": "tools/repo/test/fixtures/roots/sandbox/modules/sandbox_rules/ts/index.ts",
      "sees": ["physics", "sandbox_rules"],
      "absent": [],
      "packages": []
    }
  ],
