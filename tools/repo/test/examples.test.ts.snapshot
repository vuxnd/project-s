    "physics.bodies": "physics_basic",
    "physics.position": "physics_basic"
  },
  "events": {
    "physics.contact": "physics",
    "physics.spawn": "physics"
  },
  "types": {
    "audio.cue": 1,
    "physics.body": 1,
    "sandbox_rules.spawn": 1
  },
  "config": {
    "audio": {
      "volume": 0.5
    },
    "physics": {
      "gravity": [0, -20, 0]
    },
    "physics_basic": {
      "substeps": 1
    },
    "render_boxes": {
      "scale": 40,
      "clickBody": "sandbox_rules/crate"
    },
    "sandbox_rules": {}
  },
  "records": {
    "audio.cue": {
      "audio/contact": {
        "event": "physics.contact",
        "frequency": 440,
        "duration": 0.08
      }
    },
    "physics.body": {
      "sandbox_rules/crate": {
        "size": [1, 1, 1],
        "mass": 1
      },
      "sandbox_rules/plank": {
        "size": [4, 0.5, 2],
        "mass": 4
      }
    },
    "sandbox_rules.spawn": {
      "sandbox_rules/crate_a": {
        "body": "sandbox_rules/crate",
        "position": [0, 6, 0]
      },
      "sandbox_rules/crate_b": {
        "body": "sandbox_rules/crate",
        "position": [0.25, 9, 0]
      },
      "sandbox_rules/plank": {
        "body": "sandbox_rules/plank",
        "position": [0, 3.25, 0]
      }
    }
  },
  "assets": [],
  "schedule": {
    "fixed": ["physics_basic.integrate", "physics_basic.collide", "sandbox_rules.start"],
    "frame": ["audio.play", "render_boxes.draw"]
  },
  "schemas": {
    "state": {
      "physics_basic": "tools/repo/test/fixtures/roots/sandbox/modules/physics_basic/schemas/state.schema.json",
      "render_boxes": "tools/repo/test/fixtures/roots/sandbox/modules/render_boxes/schemas/state.schema.json"
    },
    "events": {
      "physics.contact": "tools/repo/test/fixtures/roots/sandbox/modules/physics/schemas/contact.schema.json",
      "physics.spawn": "tools/repo/test/fixtures/roots/sandbox/modules/physics/schemas/spawn.schema.json"
    },
    "params": {
      "physics.position": "tools/repo/test/fixtures/roots/sandbox/modules/physics/schemas/position_params.schema.json"
    },
    "results": {
      "physics.bodies": "tools/repo/test/fixtures/roots/sandbox/modules/physics/schemas/bodies_result.schema.json",
      "physics.position": "tools/repo/test/fixtures/roots/sandbox/modules/physics/schemas/position_result.schema.json"
    }
  }
}

`;
