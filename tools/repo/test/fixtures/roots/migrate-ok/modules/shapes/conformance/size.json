{
  "summary": "A version 1 box record is read through size.",
  "fixedHz": 60,
  "ticks": 1,
  "records": {
    "shapes.box": {
      "unit": {
        "$version": 1,
        "size": [2, 4, 6]
      }
    }
  },
  "expect": [
    {
      "at": 1,
      "call": "shapes.size",
      "equals": [2, 4, 6]
    }
  ]
}
