{
  "$schema": "../../../../../../../../../schemas/trace.schema.json",
  "summary": "Two pings arrive in the first two ticks; the implementation has counted both after three.",
  "fixedHz": 50,
  "ticks": 3,
  "records": {
    "api.item": {
      "apple": { "$version": 1, "name": "apple", "weight": 0.2 }
    }
  },
  "inputs": [
    { "at": 0, "event": "api.ping", "payload": { "n": 1 } },
    { "at": 1, "event": "api.ping", "payload": { "n": 2 } }
  ],
  "expect": [
    { "at": 3, "call": "api.count", "equals": 2 },
    { "at": 3, "call": "api.count", "near": 2, "within": 0.5 },
    { "by": 3, "emitted": "api.ping", "count": 0 }
  ]
}
