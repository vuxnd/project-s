{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spawn",
  "description": "Create a body; ignored when the id exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "body", "position"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "body": { "type": "string", "x-ref": "physics.body" },
    "position": { "$ref": "vec3.schema.json", "x-unit": "m" }
  }
}
