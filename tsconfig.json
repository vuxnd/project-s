{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["tools/**/*.ts", "hosts/**/*.ts", "modules/**/*.ts", "examples/**/*.ts"],
  "exclude": ["tools/repo/test/fixtures/**"]
}
